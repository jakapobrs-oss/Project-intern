# Admin UI — Next.js env vars
# Copy เป็น .env.local แล้วแก้ค่าตาม environment

# Backend API endpoint — proxy ผ่าน next.config.mjs rewrites
# - dev: http://localhost:8000/api  (ค่า default ใน next.config.mjs)
# - prod ใน docker compose: http://backend:8000/api  (service name)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Phase 7 — Auth mode
# - bearer (default): JWT in localStorage + Authorization header
# - cookie:           httpOnly cookies + CSRF token (production hardening)
#
# ถ้าตั้ง cookie ต้อง:
#   1. backend ใน .env ตั้ง CSRF_ENABLED=true
#   2. proxy/nginx ส่ง Set-Cookie + Cookie headers (auto ผ่าน next.config rewrites)
#   3. production HTTPS เท่านั้น (Secure cookie flag)
NEXT_PUBLIC_AUTH_MODE=bearer
