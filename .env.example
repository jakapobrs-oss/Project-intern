# Copy file นี้เป็น .env แล้วแก้ค่าให้เหมาะสมก่อนใช้งาน
# ห้าม commit .env เข้า git (อยู่ใน .gitignore แล้ว)

# ===== Database =====
POSTGRES_DB=signage
POSTGRES_USER=signage
POSTGRES_PASSWORD=signage_dev_change_me
DATABASE_URL=postgresql+asyncpg://signage:signage_dev_change_me@postgres:5432/signage

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== MinIO (S3-compatible) =====
# S3_ENDPOINT = ที่อยู่ "ฝั่งใน" ที่ backend/worker ใช้คุยกับ MinIO (ชื่อ service ใน docker network)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=signage-media
S3_REGION=us-east-1
# S3_PUBLIC_ENDPOINT = ที่อยู่ที่ "เครื่องเล่นข้างนอก" เข้าถึงได้ (LAN IP / โดเมน / CDN)
#   เว้นว่าง = เครื่องเล่นดึงไฟล์ผ่าน backend ที่ /api/v1/media (ค่าที่แนะนำ ไม่ต้องเปิดพอร์ต MinIO)
#   ⚠️ อย่าตั้งเป็น http://minio:9000 — ชื่อนี้มีแต่ใน docker network เครื่องเล่นแปลไม่ออก จอจะดำ
S3_PUBLIC_ENDPOINT=
# อายุลิงก์สื่อ (วินาที) — เครื่องเล่น poll manifest ทุก 60 วิ จึงได้ลิงก์ใหม่ก่อนหมดอายุเสมอ
MEDIA_URL_TTL_SEC=3600

# ===== JWT =====
# สำหรับ production ใช้ `openssl rand -hex 32` สร้างค่าใหม่
JWT_SECRET_KEY=change_me_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ===== Player device token (แยกจาก user JWT ตาม §26) =====
DEVICE_TOKEN_SECRET=change_me_too
DEVICE_TOKEN_EXPIRE_DAYS=365

# ===== App =====
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok
APP_DEFAULT_LANG=th
LOG_LEVEL=INFO

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ===== Seed admin (ใช้ตอน docker compose first-run) =====
# เปลี่ยน SEED_ADMIN_PASSWORD ทันทีหลัง login ครั้งแรก
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# ===== Sentry (Phase 5 — optional, ปิดถ้า DSN ว่าง) =====
# รับ DSN จาก https://sentry.io → New Project → FastAPI
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=

# ===== Phase 7 — Security hardening =====

# Rate limit สำหรับ /auth/login (กัน brute force)
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SEC=60
# backend: "memory" (single instance) หรือ "redis" (multi instance)
RATE_LIMIT_BACKEND=memory

# Reverse proxy ที่เชื่อถือได้ — มีผลกับ IP ที่บันทึกลง audit log
# ว่างไว้ (default) = ไม่เชื่อ header X-Forwarded-For เลย ใช้ IP ที่ต่อเข้ามาตรง ๆ
# ⚠️ ถ้า deploy จริงหลัง nginx (docker-compose.prod.yml) ต้องตั้งเป็นวง IP ของ nginx
#    ไม่งั้น audit จะบันทึก IP ของ nginx แทน IP ผู้ใช้ — ค่าที่ใช้ได้กับ docker network:
# TRUSTED_PROXIES=172.16.0.0/12
# หมายเหตุ dev: เปิดเว็บที่ localhost แล้วเห็น IP เป็น 172.x เป็นเรื่องปกติ Docker
#    เปลี่ยน IP ต้นทางตอน forward พอร์ตให้ ไม่ใช่บั๊ก
TRUSTED_PROXIES=

# Account lockout — ชั้นที่ 2 ถัดจาก rate limit
# กรอกรหัสผิดครบ MAX_FAILED_LOGIN ครั้ง → ล็อกชั่วคราว LOCKOUT_MINUTES นาที แล้วปลดเอง
# ⚠️ อย่าทำให้เป็นล็อกถาวร: ใครที่รู้แค่ชื่อผู้ใช้จะปิดบัญชีคนอื่นได้ตลอดกาล และถ้า
#    super_admin มีบัญชีเดียวแล้วโดนล็อก จะไม่มีใครปลดให้ (ฉุกเฉิน: python -m app.scripts.unlock_user <user>)
MAX_FAILED_LOGIN=5
LOCKOUT_MINUTES=15

# CSRF protection — เปิดเมื่อ frontend ใช้ NEXT_PUBLIC_AUTH_MODE=cookie
# (Bearer mode + localStorage ไม่ต้องเปิด — JWT ไม่ส่งอัตโนมัติเหมือน cookie)
CSRF_ENABLED=false

# Frontend auth mode — bearer (default, dev) หรือ cookie (production)
# - bearer: JWT in localStorage + Authorization header (XSS-vulnerable แต่ตั้งง่าย)
# - cookie: httpOnly cookies + CSRF (XSS-immune แต่ต้อง same-origin หรือ proper CORS)
NEXT_PUBLIC_AUTH_MODE=bearer

# ===== ClamAV virus scan (§22 — gap-closing #29) =====
# ปิดใน dev (ไม่มี clamd daemon) — เปิดใน production ที่รัน clamav container
# fail_closed=true: ถ้าต่อ clamd ไม่ได้ → ปฏิเสธ upload (ปลอดภัยกว่า)
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_FAIL_CLOSED=true
